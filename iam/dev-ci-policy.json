{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDataBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::seclab-data-111122223333"
    },
    {
      "Sid": "ReadDataObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::seclab-data-111122223333/*"
    },
    {
      "Sid": "SelfServiceKeyRotation",
      "Effect": "Allow",
      "Action": [
        "iam:CreateAccessKey",
        "iam:ListAccessKeys",
        "iam:UpdateAccessKey",
        "iam:DeleteAccessKey"
      ],
      "Resource": "arn:aws:iam::111122223333:user/dev-ci"
    }
  ]
}
