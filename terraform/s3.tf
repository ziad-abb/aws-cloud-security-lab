data "aws_caller_identity" "current" {}

locals {
  data_bucket = "${var.project}-data-${data.aws_caller_identity.current.account_id}"
  fake_csv    = "${path.module}/../data/clients.csv" # generated by scripts/gen_fake_data.py
}

# ---------- Data bucket ----------
resource "aws_s3_bucket" "data" {
  bucket        = local.data_bucket
  force_destroy = true # lab only: lets terraform destroy empty the bucket

  tags = { Name = local.data_bucket, DataClass = "fake-pii" }
}

# Disable ACLs: access is controlled only by policies.
resource "aws_s3_bucket_ownership_controls" "data" {
  bucket = aws_s3_bucket.data.id
  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

# S1 toggle: all four flags flip off when insecure_bucket = true.
resource "aws_s3_bucket_public_access_block" "data" {
  bucket                  = aws_s3_bucket.data.id
  block_public_acls       = !var.insecure_bucket
  ignore_public_acls      = !var.insecure_bucket
  block_public_policy     = !var.insecure_bucket
  restrict_public_buckets = !var.insecure_bucket
}

resource "aws_s3_bucket_versioning" "data" {
  bucket = aws_s3_bucket.data.id
  versioning_configuration {
    status = "Enabled"
  }
}

# Default encryption = SSE-S3. The KMS copy overrides it per object.
resource "aws_s3_bucket_server_side_encryption_configuration" "data" {
  bucket = aws_s3_bucket.data.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# ---------- Bucket policy ----------
data "aws_iam_policy_document" "data_bucket" {
  # Always: refuse plain HTTP (CIS).
  statement {
    sid     = "DenyInsecureTransport"
    effect  = "Deny"
    actions = ["s3:*"]
    resources = [
      aws_s3_bucket.data.arn,
      "${aws_s3_bucket.data.arn}/*",
    ]
    principals {
      type        = "*"
      identifiers = ["*"]
    }
    condition {
      test     = "Bool"
      variable = "aws:SecureTransport"
      values   = ["false"]
    }
  }

  # S1 only: public read (the deliberate misconfiguration).
  dynamic "statement" {
    for_each = var.insecure_bucket ? [1] : []
    content {
      sid       = "S1PublicReadINSECURE"
      effect    = "Allow"
      actions   = ["s3:GetObject"]
      resources = ["${aws_s3_bucket.data.arn}/*"]
      principals {
        type        = "*"
        identifiers = ["*"]
      }
    }
  }
}

resource "aws_s3_bucket_policy" "data" {
  bucket = aws_s3_bucket.data.id
  policy = data.aws_iam_policy_document.data_bucket.json

  # A public policy is rejected while Block Public Access is still on.
  depends_on = [aws_s3_bucket_public_access_block.data]
}

# ---------- Fake customer files (same content, two encryptions) ----------
resource "aws_s3_object" "clients_s3" {
  bucket       = aws_s3_bucket.data.id
  key          = "clients-s3.csv"
  source       = local.fake_csv
  source_hash  = filemd5(local.fake_csv)
  content_type = "text/csv"
  # Inherits SSE-S3: readable anonymously when S1 makes the bucket public.

  depends_on = [aws_s3_bucket_server_side_encryption_configuration.data]
}

resource "aws_s3_object" "clients_kms" {
  bucket       = aws_s3_bucket.data.id
  key          = "clients-kms.csv"
  source       = local.fake_csv
  source_hash  = filemd5(local.fake_csv) # etag isn't an MD5 with SSE-KMS, so use source_hash
  content_type = "text/csv"

  server_side_encryption = "aws:kms"
  kms_key_id             = aws_kms_key.data.arn
  # Anonymous users can't call kms:Decrypt, so this copy stays protected even in S1.
}
